{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18790,
    "auth": { "mode": "token" },
    "tailscale": { "mode": "off", "resetOnExit": false },
    "http": { "endpoints": { "chatCompletions": { "enabled": true } } }
  },
  "agents": { "defaults": { "heartbeat": { "every": "0m" } } },
  "session": { "dmScope": "per-channel-peer" },
  "tools": {
    "profile": "coding",
    "deny": [
      "music_generate",
      "video_generate",
      "image_generate",
      "get_goal",
      "create_goal",
      "update_goal",
      "skill_workshop"
    ]
  },
  "plugins": {
    "allow": ["openrouter", "ollama", "memory-core", "document-extract", "web-readability"],
    "entries": { "openrouter": { "enabled": true } }
  },
  "skills": { "allowBundled": ["weather"] },
  "auth": {
    "profiles": {
      "openrouter:default": { "provider": "openrouter", "mode": "api_key" }
    }
  }
}
